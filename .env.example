# Copy to .env.local and fill in what you use. Everything is optional.

# Speech-to-text (Phase 2). Without it, the browser's speech recognition is used.
DEEPGRAM_API_KEY=

# AI coach + one-pagers via Claude (Phase 3).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# AI coach + one-pagers via a local model in Ollama (Phase 3).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
